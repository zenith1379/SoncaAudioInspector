<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Scoped to the Impulse view and measurement details window. -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="#121214"/>
        <Setter Property="Foreground" Value="#E4E4E7"/>
        <Setter Property="BorderBrush" Value="#45454D"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="TabControl">
                <DockPanel KeyboardNavigation.TabNavigation="Local">
                    <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,5"/>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="2"/>
                    </Border>
                </DockPanel>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#D4D4D8"/>
        <Setter Property="Background" Value="#242428"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#45454D" BorderThickness="1" Margin="0,0,3,0" Padding="{TemplateBinding Padding}" CornerRadius="4,4,0,0">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#243A55"/><Setter Property="Foreground" Value="White"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#5798EF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="RowBackground" Value="#18181B"/>
        <Setter Property="AlternatingRowBackground" Value="#202024"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#34343B"/>
        <Setter Property="BorderBrush" Value="#45454D"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#2B2B31"/><Setter Property="Foreground" Value="#E4E4E7"/>
        <Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#45454D"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#243A55"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="#27272B"/>
        <Setter Property="Foreground" Value="#E4E4E7"/>
        <Setter Property="BorderBrush" Value="#45454D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="MinHeight" Value="29"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#38383F"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#18181B"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#5798EF"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Background" Value="#202024"/>
        <Setter Property="BorderBrush" Value="#73737D"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="14" Height="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="M 2,6 L 5,9 L 10,2" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" Margin="0,0,0,1"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" ContentSource="Content" Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#B4B4BD"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#5798EF"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="29"/>
        <Setter Property="BorderBrush" Value="#45454D"/>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#18181B"/>
        <Setter Property="Foreground" Value="#E4E4E7"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="#35353C"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#243A55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#25252B"/>
        <Setter Property="Foreground" Value="#E4E4E7"/>
        <Setter Property="BorderBrush" Value="#52525B"/>
        <Setter Property="Padding" Value="9,6"/>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="#202024"/>
        <Setter Property="Foreground" Value="#E4E4E7"/>
        <Setter Property="BorderBrush" Value="#45454D"/>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="#202024"/>
        <Setter Property="Foreground" Value="#E4E4E7"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
</ResourceDictionary>
